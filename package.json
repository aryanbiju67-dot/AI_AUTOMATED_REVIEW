{
  "name": "review-qr-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "npm run build:dev && concurrently -k \"vite build --watch --mode development --configLoader runner --outDir dist\" \"wrangler pages dev dist\"",
    "dev:vercel": "npx --yes vercel --global-config .vercel/cli-global dev",
    "build:dev": "vite build --mode development --configLoader runner --outDir dist",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && npx --yes vercel --global-config .vercel/cli-global --prod",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.7.0",
    "vite": "^7.2.2",
    "wrangler": "^4.46.0"
  }
}
